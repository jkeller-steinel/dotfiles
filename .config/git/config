	name = Jonas Richard Keller
	email = jonas.keller@steinel.de
	signingkey = key::ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAILLSohfVkxBWKq63xIqoyK8g5s6fILhvk4h5eSBtTk4W jonas.r.keller@gmail.com
[init]
	defaultBranch = main
[merge]
	conflictstyle = diff3
[diff]
	algorithm = histogram
	renames = copies
[core]
	editor = vim
[alias]
	tree = log --graph --pretty=\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an <%ae>%Creset\" --all
[push]
	autoSetupRemote = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
