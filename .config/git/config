[user]
	name = Jonas Richard Keller
	email = jonas.keller@steinel.de
[init]
	defaultBranch = main
[merge]
	conflictstyle = diff3
[diff]
	algorithm = histogram
	renames = copies
[core]
	editor = vim
[url "ssh://git@steinel.gitlabhosting.com"]
	insteadOf = https://steinel.gitlabhosting.com
[alias]
	tree = log --graph --pretty=\"%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)%an <%ae>%Creset\" --all
[push]
	autoSetupRemote = true
